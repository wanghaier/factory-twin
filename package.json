{
  "name": "factory-twin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "基于 Vue 3、Babylon.js 和 Electron 的智慧工厂数字孪生与泄漏检测可视化平台",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve:offline": "node scripts/serve-offline.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "vendor": "node scripts/copy-vendor-assets.mjs",
    "icon": "node scripts/make-icon.mjs",
    "app:dev": "electron .",
    "app:pack": "node scripts/pack.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.27.1",
    "@babylonjs/loaders": "9.27.1",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@vitejs/plugin-vue": "6.0.9",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "meshoptimizer": "^1.3.0",
    "vite": "8.3.0"
  },
  "build": {
    "appId": "cn.factorytwin.desktop",
    "productName": "智慧工厂数字孪生",
    "executableName": "FactoryTwin",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.ico"
    }
  }
}
